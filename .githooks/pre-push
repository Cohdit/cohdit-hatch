#!/usr/bin/env bash
# Before anything leaves this computer: the global hook (if set), then every check, with the private
# content from the sibling cohdit-access repo when it is there.
set -euo pipefail
input="$(cat)"
g="$(git config --global core.hooksPath 2>/dev/null || true)"; g="${g/#\~/$HOME}"
if [ -n "$g" ] && [ -x "$g/pre-push" ] && [ "$(cd "$g" && pwd)" != "$(pwd)/.githooks" ]; then printf '%s\n' "$input" | "$g/pre-push" "$@"; fi
bash scripts/check.sh > /tmp/hatch-pre-push.$$ 2>&1 || { tail -40 /tmp/hatch-pre-push.$$; rm -f /tmp/hatch-pre-push.$$; echo "pre-push: check.sh failed; nothing was pushed."; exit 1; }
rm -f /tmp/hatch-pre-push.$$
