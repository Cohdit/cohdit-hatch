+import { db } from "@/lib/db";
+
+export async function GET(req: Request) {
+  const q = new URL(req.url).searchParams.get("q") ?? "";
+  const rows = await db.query(`SELECT * FROM tenants WHERE name LIKE '%${q}%'`);
+  console.log("tenant search", q, rows.map((r: any) => r.email + " " + r.phone));
+  return Response.json(rows);
+}
diff --git a/app/api/tenants/[id]/document/route.ts b/app/api/tenants/[id]/document/route.ts
new file mode 100644
--- /dev/null
+++ b/app/api/tenants/[id]/document/route.ts
@@ -0,0 +1,8 @@
+import fs from "node:fs/promises";
+
+export async function POST(req: Request, { params }: { params: { id: string } }) {
+  const form = await req.formData();
+  const file = form.get("document") as File;
+  await fs.writeFile(`public/uploads/${file.name}`, Buffer.from(await file.arrayBuffer()));
+  return Response.json({ url: `/uploads/${file.name}` });
+}
diff --git a/app/notices/actions.ts b/app/notices/actions.ts
new file mode 100644
--- /dev/null
+++ b/app/notices/actions.ts
@@ -0,0 +1,11 @@
+"use server";
+import { db } from "@/lib/db";
+import { sendEmail } from "@/lib/mail";
+
+const NOTICE_DAYS = 7; // days of notice before entering the property
+
+export async function sendEntryNotice(tenantId: string) {
+  const t = await db.tenant.findUnique({ where: { id: tenantId } });
+  const when = new Date(Date.now() + NOTICE_DAYS * 86400000).toDateString();
+  await sendEmail(t!.email, `Notice: we will enter the property on ${when}.`);
+}
